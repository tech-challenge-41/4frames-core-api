# =============================================================================
# 4frames-core-api — um único .env na raiz para todos os pacotes e para o Compose
#   cp .env.example .env
#
# Os endereços abaixo são os do host (localhost), usados quando os apps rodam com pnpm:
#   docker compose up -d postgres redis mailpit localstack
#   pnpm dev:api
#
# Quando os apps rodam dentro do Compose (docker compose up -d --build), o docker-compose.yml
# sobrescreve só os hosts internos (postgres, localstack, redis, mailpit). Não é preciso
# editar este arquivo para trocar de modo.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=3000
CI=true
LOG_LEVEL=debug
# Origens liberadas no CORS da API (front em dev e front servido pelo nginx)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Prazo do encerramento gracioso da API depois do SIGTERM: fecha os streams SSE, espera as requisições em
# curso e fecha Prisma e Redis. No cluster fica abaixo do terminationGracePeriodSeconds. Padrão: 20
# API_SHUTDOWN_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# PostgreSQL
# Os apps usam DB_*; o container postgres usa os mesmos valores (ver docker-compose.yml)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=4frames_core
DB_SCHEMA=public
DB_SSLMODE=disable
DB_USERNAME=admin
DB_PASSWORD=123456

# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change_me
JWT_EXPIRES_IN=21600

# -----------------------------------------------------------------------------
# AWS (LocalStack em desenvolvimento)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Endpoint que os apps usam para falar com S3 e SQS
AWS_ENDPOINT_URL=http://localhost:4566
# Endpoint usado só para assinar as URLs que o navegador abre. Continua localhost mesmo com a
# API dentro do Compose, porque quem acessa a URL é o navegador. Vazio: usa o AWS_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566

# -----------------------------------------------------------------------------
# S3
# -----------------------------------------------------------------------------
S3_BUCKET_NAME=4frames-videos
# Validade, em segundos, da URL pré-assinada de upload
UPLOAD_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# SQS (fila de uploads e DLQ criadas por infra/localstack/init/10-sqs.sh)
# VISIBILITY_TIMEOUT_SECONDS é aplicado na fila e pedido pelo worker a cada recebimento; o worker
# renova a visibilidade na metade desse tempo enquanto processa um vídeo
# -----------------------------------------------------------------------------
SQS_QUEUE_URL=http://localhost:4566/000000000000/4frames-video-uploads
SQS_DLQ_URL=http://localhost:4566/000000000000/4frames-video-uploads-dlq
VISIBILITY_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Redis (progresso e eventos de job, publicados pelo worker)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Worker
# Regra do projeto base: 1 frame por segundo, PNG (frame_0001.png, frame_0002.png...)
# -----------------------------------------------------------------------------
FRAME_FPS=1
FRAME_FORMAT=png
MAX_VIDEO_DURATION_SECONDS=600
# Arquivos temporários de cada job. Sem valor: pasta 4frames no diretório temporário do sistema.
# No Compose é /tmp/4frames (sobrescrito no docker-compose.yml).
# WORKER_TMP_DIR=/tmp/4frames
# GET /healthz para a liveness probe
WORKER_HEALTH_PORT=9100
# Tempo para terminar o job atual depois do SIGTERM (abaixo do stop_grace_period de 10 min)
WORKER_SHUTDOWN_TIMEOUT_SECONDS=570
# Limite de uma execução do ffmpeg; ao estourar, o job volta à fila
FFMPEG_TIMEOUT_SECONDS=1800
# Consumidores SQS no mesmo processo (1 job ativo por consumidor). Padrão: 2
# Vídeos em paralelo no mesmo processo worker (event loop; default 2).
# WORKER_MAX_PARALLEL_JOBS=2
# WORKER_CONCURRENCY=2  # alias legado de WORKER_MAX_PARALLEL_JOBS

# -----------------------------------------------------------------------------
# E-mail — apps/notifier
# -----------------------------------------------------------------------------
# Padrão: Mailpit, o substituto local do SES (ADR-002 §2.1). Caixa em http://localhost:8025.
# Estes valores são os do host (pnpm dev:*); no Compose o bloco x-container-endpoints troca o
# host por `mailpit`. Sem usuário e senha: o Mailpit não pede autenticação.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Provedor SMTP externo (Mailtrap, por exemplo) em vez do Mailpit. Vale direto para o notifier
# no host; no Compose é preciso comentar SMTP_HOST/SMTP_PORT no bloco x-container-endpoints do
# docker-compose.yml, que sobrescreve os dois para o Mailpit:
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=<usuario>
# SMTP_PASSWORD=<senha>   # alias aceito: SMTP_PASS
MAIL_FROM="4Frames <no-reply@4frames.local>"
# Base do link enviado no e-mail (front em desenvolvimento)
WEB_APP_URL=http://localhost:5173
# GET /healthz para a liveness probe
NOTIFIER_HEALTH_PORT=9100
# NOTIFIER_RECOVERY_INTERVAL_SECONDS=120
# NOTIFIER_RECOVERY_BATCH_SIZE=20

# -----------------------------------------------------------------------------
# Datadog / OpenTelemetry (Agent local no Compose — ver DATADOG_README.md)
# -----------------------------------------------------------------------------
APP_ENV=development
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_TARGET=agent
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_SERVICE_NAME=4frames-api
OTEL_SERVICE_VERSION=1.0.0
# Chave do Agent (conta no Datadog, site us5). Sem ela, ./scripts/k8s-local.sh up para no passo do Agent,
# e o datadog-agent do Compose não tem como enviar ao Datadog.
DD_API_KEY=
# Não usada pelos apps nem pelos scripts.
DD_APP_KEY=
DD_SITE=us5.datadoghq.com
DD_ENV=development
DD_SERVICE=4frames-api
DD_VERSION=1.0.0
DD_METRICS_ENABLED=true
# Host: pnpm dev:* → localhost. No Compose o docker-compose sobrescreve para datadog-agent.
DD_AGENT_HOST=localhost
