# =============================================================================
# 4frames-core-api — um único .env na raiz para todos os pacotes e para o Compose
#   cp .env.example .env
#
# Os endereços abaixo são os do host (localhost), usados quando os apps rodam com pnpm:
#   docker compose up -d postgres redis mailpit localstack
#   pnpm dev:api
#
# Quando os apps rodam dentro do Compose (docker compose up -d --build), o docker-compose.yml
# sobrescreve só os hosts internos (postgres, localstack, redis, mailpit). Não é preciso
# editar este arquivo para trocar de modo.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=3000
CI=true
LOG_LEVEL=debug
# Origens liberadas no CORS da API (front em dev e front servido pelo nginx)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# -----------------------------------------------------------------------------
# PostgreSQL
# Os apps usam DB_*; o container postgres usa os mesmos valores (ver docker-compose.yml)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=4frames_core
DB_SCHEMA=public
DB_SSLMODE=disable
DB_USERNAME=admin
DB_PASSWORD=123456

# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change_me
JWT_EXPIRES_IN=21600

# -----------------------------------------------------------------------------
# AWS (LocalStack em desenvolvimento)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Endpoint que os apps usam para falar com S3 e SQS
AWS_ENDPOINT_URL=http://localhost:4566
# Endpoint usado só para assinar as URLs que o navegador abre. Continua localhost mesmo com a
# API dentro do Compose, porque quem acessa a URL é o navegador. Vazio: usa o AWS_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566

# -----------------------------------------------------------------------------
# S3
# -----------------------------------------------------------------------------
S3_BUCKET_NAME=4frames-videos
# Validade, em segundos, da URL pré-assinada de upload
UPLOAD_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# SQS (fila de uploads e DLQ criadas por infra/localstack/init/10-sqs.sh)
# VISIBILITY_TIMEOUT_SECONDS é aplicado na fila; as URLs ainda não são lidas por nenhum app
# -----------------------------------------------------------------------------
SQS_QUEUE_URL=http://localhost:4566/000000000000/4frames-video-uploads
SQS_DLQ_URL=http://localhost:4566/000000000000/4frames-video-uploads-dlq
VISIBILITY_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Redis (progresso e eventos de job) — ainda não lido por nenhum app
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Worker — ainda não lido: o consumer da fila ainda não existe
# Regra do projeto base: 1 frame por segundo, PNG (frame_0001.png, frame_0002.png...)
# -----------------------------------------------------------------------------
FRAME_FPS=1
FRAME_FORMAT=png
MAX_VIDEO_DURATION_SECONDS=600

# -----------------------------------------------------------------------------
# E-mail (Mailpit em desenvolvimento, caixa em http://localhost:8025)
# Ainda não lido: o notifier ainda não envia e-mail
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="4Frames <no-reply@4frames.local>"
# Base do link enviado no e-mail (front em desenvolvimento)
WEB_APP_URL=http://localhost:5173
