{
  "name": "4frames-core-api",
  "version": "1.0.0",
  "main": "dist/main.js",
  "repository": "git@github.com:tech-challenge-41/4frames-core-api.git",
  "author": "Tech Challenge 41 - 4Frames",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
    "prebuild": "prisma generate",
    "build": "tsc && tsc-alias",
    "type-check": "tsc --noEmit",
    "start": "node dist/main.js",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "test": "jest --coverage",
    "test:watch": "ts-jest --watch",
    "test:coverage": "ts-jest --coverage",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eduzz/eslint-config": "^2.5.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "7.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.1.12"
  }
}
