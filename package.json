{
  "name": "4frames-core-api",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo do backend do 4Frames: api, worker, notifier e pacote shared",
  "repository": "git@github.com:tech-challenge-41/4frames-core-api.git",
  "author": "Tech Challenge 41 - 4Frames",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @4frames/shared db:generate && pnpm --filter @4frames/shared build",
    "build": "pnpm -r --if-present build",
    "type-check": "pnpm --filter @4frames/shared build && pnpm -r --if-present type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml}\"",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @4frames/e2e e2e",
    "dev:shared": "pnpm --filter @4frames/shared dev",
    "dev:api": "pnpm --filter @4frames/shared build && pnpm --filter @4frames/api dev",
    "dev:worker": "pnpm --filter @4frames/shared build && pnpm --filter @4frames/worker dev",
    "dev:notifier": "pnpm --filter @4frames/shared build && pnpm --filter @4frames/notifier dev",
    "db:generate": "pnpm --filter @4frames/shared db:generate",
    "db:migrate": "pnpm --filter @4frames/shared db:migrate",
    "db:deploy": "pnpm --filter @4frames/shared db:deploy",
    "db:seed": "pnpm --filter @4frames/shared db:seed",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix --no-warn-ignored",
    "*.{md,json,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eduzz/eslint-config": "^2.5.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.9.3"
  }
}
