enum VideoJobStatus {
  UPLOAD_PENDING
  QUEUED
  PROCESSING
  DONE
  FAILED
  EXPIRED
}

model video_jobs {
  /// UUID gerado pelo banco: o id aparece em URL compartilhável e não pode ser enumerável.
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          Int
  user             users          @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  file_name        String
  content_type     String
  /// Tamanho declarado no POST /videos, em bytes.
  file_size        BigInt
  status           VideoJobStatus @default(UPLOAD_PENDING)
  /// Motivo legível da falha, preenchido quando status = FAILED.
  failure_reason   String?
  /// Chave do zip no bucket (zips/{userId}/{jobId}.zip), preenchida quando status = DONE.
  zip_key          String?
  frame_count      Int?
  duration_seconds Float?
  /// Momento em que o dono foi notificado do estado terminal (idempotência do notifier).
  notified_at      DateTime?
  /// correlationId da requisição que criou o job, propagado para worker e notifier nos logs.
  correlation_id   String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@index([user_id, created_at(sort: Desc)])
}
