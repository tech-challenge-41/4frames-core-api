{
  "name": "@4frames/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Worker do 4Frames: consome a fila SQS, extrai frames com ffmpeg e gera o zip",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
    "build": "tsc && tsc-alias",
    "type-check": "tsc --noEmit",
    "start": "node dist/main.js",
    "test": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@4frames/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/client-sqs": "^3.1119.0",
    "@aws-sdk/lib-storage": "^3.1119.0",
    "archiver": "^7.0.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "adm-zip": "^0.6.1"
  }
}
